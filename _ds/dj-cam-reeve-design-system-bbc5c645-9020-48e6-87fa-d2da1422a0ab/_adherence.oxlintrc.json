{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/corporate-landing/**",
              "ui_kits/wedding-landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Archivo|Montserrat|Open Sans|Libre Baskerville))/i]",
        "message": "Font not provided by the design system. Available: Anton, Archivo, Montserrat, Open Sans, Libre Baskerville."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|support|neutral|bright)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'support' | 'neutral' | 'bright'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|wash)$/]",
        "message": "<Badge> variant must be one of 'outline' | 'solid' | 'wash'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|as|disabled|block|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, as, disabled, block, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|outline|ghost|solid)$/]",
        "message": "<Button> variant must be one of 'accent' | 'outline' | 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:accentBar|hover|pad|field|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: accentBar, hover, pad, field, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|tight|base|loose)$/]",
        "message": "<Card> pad must be one of 'none' | 'tight' | 'base' | 'loose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='field'] > Literal[value!=/^(?:raised|inset|none)$/]",
        "message": "<Card> field must be one of 'raised' | 'inset' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|as|accentWord|align|measure|style|key|ref|className|style|children)$/]",
        "message": "<DisplayHeading> doesn't accept that prop. Declared props: children, level, as, accentWord, align, measure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DisplayHeading> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, size, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|primary|secondary|muted|support)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'primary' | 'secondary' | 'muted' | 'support'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Eyebrow> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|htmlFor|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, htmlFor, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|combo|size|round|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<LetterTile> doesn't accept that prop. Declared props: letter, combo, size, round, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterTile'] > JSXAttribute[name.name='letter'] > Literal[value!=/^(?:D|J|C|A|M)$/]",
        "message": "<LetterTile> letter must be one of 'D' | 'J' | 'C' | 'A' | 'M'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterTile'] > JSXAttribute[name.name='combo'] > Literal[value!=/^(?:coral-purple|coral-white|purple-coral|black-white|white-black)$/]",
        "message": "<LetterTile> combo must be one of 'coral-purple' | 'coral-white' | 'purple-coral' | 'black-white' | 'white-black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:colorway|width|assetBase|clearSpace|bar|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: colorway, width, assetBase, clearSpace, bar, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='colorway'] > Literal[value!=/^(?:white|black|coral|purple|magenta|ice-blue)$/]",
        "message": "<Logo> colorway must be one of 'white' | 'black' | 'coral' | 'purple' | 'magenta' | 'ice-blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|grade|scrim|caption|placeholder|children|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, ratio, grade, scrim, caption, placeholder, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:none|base|hero|mono)$/]",
        "message": "<PhotoFrame> grade must be one of 'none' | 'base' | 'hero' | 'mono'."
      },
