      },
      {
        "selector": "JSXOpeningElement[name.name='PlayBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|caption|duration|playing|onToggle|bars|progress|style|key|ref|className|style|children)$/]",
        "message": "<PlayBlock> doesn't accept that prop. Declared props: title, meta, caption, duration, playing, onToggle, bars, progress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|children|attribution|role|level|align|style|key|ref|className|style|children)$/]",
